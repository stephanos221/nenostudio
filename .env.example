# Copy to .env.local (development) or set in the hosting environment (production). Nothing here is required to run.

# Public origin of the site, without a trailing slash. Read at BUILD time: it turns the relative social-image paths in
# the page metadata (og:image, twitter:image) into absolute URLs. Without it they use the production domain on Vercel
# (VERCEL_PROJECT_PRODUCTION_URL), or http://localhost:3000 elsewhere.
# NEXT_PUBLIC_SITE_URL=https://www.example.com

# Where /api/contact forwards each valid enquiry (JSON POST: { name, email, phone, message }), for example a form
# service or chat webhook. Treat the URL as a secret. Without it enquiries are acknowledged but NOT delivered or stored.
CONTACT_WEBHOOK_URL=

# Password accepted by the form on /401. While empty, every attempt is rejected.
SITE_PASSWORD=
